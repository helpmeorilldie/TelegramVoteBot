# Copy this file to  .env  (note the leading dot) and fill it in

# Token from @BotFather
BOT_TOKEN=

# Your numeric Telegram id (from @userinfobot). Extra admins are optional.
OWNER_ID=6592441427
ADMIN_IDS=

# Channel where names are posted and people vote. The bot must be ADMIN there.
# @username for public channels, or -100xxxxxxxxxx for private ones.
CHANNEL_ID=@hitsfromhaze
# Join link shown to users (needed when CHANNEL_ID is numeric)
CHANNEL_LINK=https://t.me/hitsfromhaze
# Optional: extra channels/groups users must also be in (comma separated)
REQUIRED_CHATS=@ecochamber

# PRIVATE channel for backups + logs (numeric id, starts with -100). Bot must be ADMIN
# with "Post messages" and "Pin messages".
STORAGE_CHANNEL_ID=-1003980472801

# Branding (shown in "Developer & Host")
HOST_NAME=Erebus
DEV_NAME=Haze
DEV_HANDLE=@Noxmirage

# Optional
DB_PATH=data/votebot.sqlite3
BACKUP_DIR=backups
BACKUP_EVERY_HOURS=1
BACKUP_EVERY_CHANGES=25
USE_CUSTOM_EMOJI=1
# Set on Render/Railway etc. to start the tiny keep-alive web page (Render sets PORT itself)
# KEEP_ALIVE=1
